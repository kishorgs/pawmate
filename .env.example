# ============================================================
# PawMate — Environment Variables (NEVER commit real values)
# ============================================================
# Copy to .env.local for local dev. In Lovable, set via the Secrets UI.

# ---- Firebase Web SDK (PUBLIC — safe in client bundle) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# ---- Firebase Admin (SERVER-ONLY — service account) --------
# Paste the entire service-account JSON as one string (use JSON.stringify-safe).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional override; defaults to project_id from the service account JSON.
FIREBASE_PROJECT_ID=

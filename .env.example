# ============================================================
# PawMate — Environment Variables (NEVER commit real values)
# ============================================================
# Copy frontend values into apps/frontend/.env.local and backend values into apps/backend/.env

# ---- Frontend (Next.js public vars; safe in client bundle) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ---- Backend (server-only vars) ------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Paste the entire Firebase service account JSON as one string.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=


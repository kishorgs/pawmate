rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'ADMIN';
    }

    function isLinkedOwner(ownerId) {
      return isSignedIn()
        && userDoc().role == 'OWNER'
        && userDoc().ownerId == ownerId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /owners/{ownerId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow write: if false;
    }

    match /pets/{petId} {
      allow read: if isAdmin() || isLinkedOwner(resource.data.ownerId);
      allow write: if false;
    }

    match /veterinarians/{vetId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || isLinkedOwner(resource.data.ownerId);
      allow write: if false;
    }

    match /visits/{visitId} {
      allow read: if isAdmin() || isLinkedOwner(resource.data.ownerId);
      allow write: if false;
    }

    match /reminders/{reminderId} {
      allow read: if isAdmin() || isLinkedOwner(resource.data.ownerId);
      allow write: if false;
    }
  }
}
